<%- include("partials/header") -%>
<link rel="stylesheet" href="/css/otvoreniNaloziNovo.css?v=3">

<script>
    // Podaci ostaju isti kao u postojećoj Express/EJS ruti.
    var nalozi = <%- JSON.stringify(nalozi || []).replace(/</g, "\\u003c") %>;
    var majstori = <%- JSON.stringify(majstori || []).replace(/</g, "\\u003c") %>;
    var prikazOpstina = <%- JSON.stringify(prikazOpstina || []).replace(/</g, "\\u003c") %>;
</script>

